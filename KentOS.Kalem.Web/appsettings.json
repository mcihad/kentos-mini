{
  // ═══════════════════════════════════════════════════════════════════════
  //  BU DOSYADA KURUMA ÖZEL BİLGİ VE SIR YOKTUR.
  //
  //  Kurum adı, alan adı, SMS hesabı, veritabanı parolası, imza anahtarı ve
  //  benzeri her şey `.env` dosyasından gelir (bkz. `.env.example`). Sebep:
  //  uygulama başka belediyelere verilecek ve açık kaynak olacak; kaynak
  //  ağacında kuruma özel tek satır bulunmamalı.
  //
  //  Ortam değişkenleri bu dosyayı EZER, dolayısıyla buradaki değerler
  //  yalnızca "hiç ayar verilmemişse" geçerli olan güvenli varsayılanlardır.
  //
  //  Kurum KİMLİĞİ (ad, amblem, renkler) ayrıca veritabanındadır —
  //  `kurum_bilgileri` tablosu, arayüzden düzenlenir.
  // ═══════════════════════════════════════════════════════════════════════

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    // Açılışta bekleyen migration'lar uygulansın mı? Çok örnekli kurulumlarda
    // false yapın: iki örnek aynı anda şema değiştirmeye kalkar.
    "AutoMigrate": true
  },

  "Storage": {
    // "Local" (disk, wwwroot/uploads) ya da "S3" (MinIO/AWS S3 uyumlu).
    "Provider": "Local",
    "UploadPath": "uploads",
    // Boşken wwwroot/uploads/gonderim kullanılır.
    "SendDirectory": ""
  },

  "Jwt": {
    // Ömür DAKİKA cinsindendir. İmza anahtarı burada YOK — `.env` içindeki
    // Jwt__Secret zorunludur, tanımsızsa uygulama açılışta durur.
    "TokenExpiration": 900
  }
}
