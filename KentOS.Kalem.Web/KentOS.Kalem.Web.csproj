<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<UserSecretsId>733db40e-58c4-466d-83df-24604e822fe3</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<!--<PackageReference Include="EFCore.NamingConventions" Version="8.0.3" />-->
		<PackageReference Include="DotNetEnv" Version="3.2.0" />
		<PackageReference Include="FluentValidation" Version="12.0.0" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
		<PackageReference Include="Mapster" Version="10.0.9" />
		<PackageReference Include="Mapster.DependencyInjection" Version="10.0.9" />
		<PackageReference Include="ClosedXML" Version="0.104.2" />
		<PackageReference Include="EFCore.NamingConventions" Version="10.0.0" />
		<PackageReference Include="FirebaseAdmin" Version="3.1.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Minio" Version="6.0.5" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
		<PackageReference Include="QuestPDF" Version="2024.12.2" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="7.2.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="7.2.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\KentOS.Kalem.Application\KentOS.Kalem.Application.csproj" />
	</ItemGroup>

	<!--
	  KART FONTLARI ÇIKTIYA KOPYALANIR.

	  QuestPDF yalnızca Lato ile geliyor; isim kartlarında istenen tipografik
	  çeşitlilik için beş aile depoya alındı (hepsi SIL OFL ve Türkçe tam:
	  ğĞ şŞ ıİ çÇ öÖ üÜ ölçüldü). Sistem fontuna ADIYLA güvenmek riskli —
	  geliştirme Mac'inde duran "Georgia" yayın sunucusunda olmayabiliyor ve
	  PDF sessizce başka bir fonta düşüyordu.
	-->
	<ItemGroup>
	  <None Include="Fontlar\*.ttf">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </None>
	</ItemGroup>

	<!-- Testlerin `Program` sınıfını (top-level statements) görebilmesi için.
	     v1 sözleşme testi WebApplicationFactory<Program> kullanıyor. -->
	<ItemGroup>
	  <InternalsVisibleTo Include="KentOS.Kalem.Tests" />
	</ItemGroup>

	<!-- ================= Ön yüz (Vite) derlemesi ================= -->
	<PropertyGroup>
		<OnYuzDizini>$(MSBuildProjectDirectory)/frontend</OnYuzDizini>
		<!-- Vite çıktısı `wwwroot` KÖKÜNE yazıyor (`vite.config.ts` → outDir
		     '../wwwroot', assetsDir 'uygulama'). Bu değer bir dönem
		     `wwwroot/yeni` idi — uygulama o adres altındayken doğruydu, köke
		     taşınınca kaldı. -->
		<OnYuzCikti>$(MSBuildProjectDirectory)/wwwroot</OnYuzCikti>
		<!-- Damga `obj` altında: `wwwroot/yeni` artık üretilmiyor ve temiz bir
		     klonda o dizin hiç yok — `Touch` "yol bulunamadı" ile derlemeyi
		     kırıyordu. `obj` her derlemede zaten var. -->
		<OnYuzDamga>$(MSBuildProjectDirectory)/obj/vite-damga</OnYuzDamga>
		<SkipFrontend Condition="'$(SkipFrontend)'==''">false</SkipFrontend>
		<NpmKomutu Condition="'$(NpmKomutu)'==''">npm</NpmKomutu>
		<!-- node_modules ve üretilmiş çıktı proje dosyalarına DAHİL EDİLMEZ:
		     Web SDK'sı **/* globluyor; on binlerce dosyayı taramaya kalkardı.

		     `wwwroot/uploads/**` KULLANICI VERİSİDİR, kaynak değil: etkinlik
		     fotoğrafları, talep dosyaları, özgeçmişler ve kullanıcıdan
		     kullanıcıya gönderilen belgeler. Yayın çıktısına girmesi iki ayrı
		     sorun demekti — geliştirme makinesindeki (kişiye özel olabilen)
		     dosyalar sunucuya taşınır ve "hedefte fazla dosyaları sil"
		     seçeneğiyle senkronlanan bir yayın ÜRETİMDEKİ yüklemeleri silerdi.
		     Klasörü uygulama açılışta kendisi oluşturuyor. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);frontend/node_modules/**;wwwroot/yeni/**;wwwroot/uploads/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<Content Remove="frontend/**" />
		<None Remove="frontend/**" />
		<!-- dotnet watch, Vite'ın her HMR yazımında sunucuyu yeniden başlatmasın -->
		<Watch Remove="frontend/**" />
	</ItemGroup>

	<ItemGroup>
		<OnYuzGirdileri Include="$(OnYuzDizini)/src/**/*;$(OnYuzDizini)/public/**/*" />
		<OnYuzGirdileri Include="$(OnYuzDizini)/index.html;$(OnYuzDizini)/package.json;&#xA;		                         $(OnYuzDizini)/package-lock.json;$(OnYuzDizini)/vite.config.ts;&#xA;		                         $(OnYuzDizini)/tailwind.config.ts;$(OnYuzDizini)/postcss.config.js;&#xA;		                         $(OnYuzDizini)/tsconfig.json" />
	</ItemGroup>

	<!-- npm var mı? nvm ile kurulu node çoğu IDE/CI kabuğunun PATH'inde olmaz;
	     sessizce patlamak yerine ne yapılacağını söyleyen bir hata verilir. -->
	<Target Name="OnYuzYokla" Condition="'$(SkipFrontend)'!='true'">
		<Exec Command="$(NpmKomutu) --version" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
			<Output TaskParameter="ExitCode" PropertyName="NpmCikis" />
		</Exec>
		<Error Condition="'$(NpmCikis)'!='0'" Text="npm bulunamadı. nvm kullanıyorsanız PATH'e ekleyin, -p:NpmKomutu=/tam/yol/npm verin ya da -p:SkipFrontend=true ile ön yüz derlemesini atlayın." />
	</Target>

	<Target Name="OnYuzKur" DependsOnTargets="OnYuzYokla" Condition="'$(SkipFrontend)'!='true' AND !Exists('$(OnYuzDizini)/node_modules/.package-lock.json')">
		<Exec WorkingDirectory="$(OnYuzDizini)" Command="$(NpmKomutu) ci" />
	</Target>

	<!-- Girdiler/Çıktılar sayesinde ön yüzde değişiklik yoksa hedef tamamen atlanır. -->
	<Target Name="OnYuzDerle" AfterTargets="Build" DependsOnTargets="OnYuzKur" Condition="'$(SkipFrontend)'!='true'" Inputs="@(OnYuzGirdileri)" Outputs="$(OnYuzDamga)">
		<Exec WorkingDirectory="$(OnYuzDizini)" Command="$(NpmKomutu) run build" />
		<Touch Files="$(OnYuzDamga)" AlwaysCreate="true" />
	</Target>

	<!-- Publish: Content öğeleri DEĞERLENDİRME anında toplanıyor; Vite çıktısı
	     (`index.html`, `uygulama/`) o an henüz üretilmemiş olabiliyor ve ayrıca
	     `.gitignore`'da olduğu için temiz bir klonda hiç yok. Bu yüzden publish
	     listesine elle eklenir.

	     `uploads/` DIŞARIDA: kullanıcı dosyaları (özgeçmiş, etkinlik fotoğrafı)
	     yayın çıktısına girmemeli — geliştirme makinesindeki belgeleri sunucuya
	     taşırdı. -->
	<Target Name="OnYuzYayinla" AfterTargets="OnYuzDerle" BeforeTargets="ComputeFilesToPublish" Condition="'$(SkipFrontend)'!='true'">
		<ItemGroup>
			<_OnYuzDosyalari Include="$(OnYuzCikti)/uygulama/**/*" />
			<_OnYuzDosyalari Include="$(OnYuzCikti)/index.html" />
			<_OnYuzDosyalari Include="$(OnYuzCikti)/firebase-messaging-sw.js" />
			<ResolvedFileToPublish Include="@(_OnYuzDosyalari)">
				<RelativePath>wwwroot/$([MSBuild]::MakeRelative('$(OnYuzCikti)', '%(FullPath)'))</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

</Project>
