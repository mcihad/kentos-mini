<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS yapılandırması.

  Bu dosya depoda DURUR; `dotnet publish` onu silmez, üzerine `aspNetCore`
  işleyicisini ekleyerek dönüştürür. Yayın çıktısındaki web.config bu dosyanın
  dönüştürülmüş hâlidir — elle düzenlenmesi gereken tek yer burasıdır.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <!--
            IIS'in KENDİ istek boyutu sınırı, istek ASP.NET Core'a ULAŞMADAN
            uygulanır ve varsayılanı 30.000.000 bayttır (~28,6 MB).

            Dosya gönderimi ucu 25 MB'a kadar dosya kabul ediyor; çok parçalı
            gövde ek yüküyle birlikte varsayılan sınıra dayanıyor ve kullanıcı
            uygulamanın anlaşılır hatası yerine IIS'in "404.13" sayfasını
            görüyordu. Sınır 50 MB'a çekildi: artık konuşan taraf uygulamanın
            kendi `RequestSizeLimit` denetimi.
          -->
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>

      <staticContent>
        <!--
          İstekler `hostingModel="inprocess"` ile ASP.NET Core'a gidiyor ve
          MIME türlerini o belirliyor; yine de statik dosyalar IIS üzerinden
          servis edilecek şekilde yapılandırılırsa (alt uygulama, sanal dizin)
          bu uzantılar bilinmediği için 404 dönerdi.
        -->
        <remove fileExtension=".webmanifest" />
        <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
        <remove fileExtension=".webp" />
        <mimeMap fileExtension=".webp" mimeType="image/webp" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
