# ═══════════════════════════════════════════════════════════════════════════
#  WORKCOLLAB — YAPILANDIRMA ŞABLONU
#
#  Bu dosya ŞABLONDUR. Kopyalayıp `.env` adıyla kaydedin ve doldurun:
#
#      cp .env.example .env
#
#  `.env` depoya GİRMEZ (bkz. .gitignore); bu şablon girer.
# ═══════════════════════════════════════════════════════════════════════════
#
#  ── BİÇİM ────────────────────────────────────────────────────────────────
#  .NET'in kendi kuralı kullanılır: iki alt çizgi bölüm ayırıcıdır.
#
#      Bolum__Alt=deger              →  yapılandırma anahtarı "Bolum:Alt"
#      Bolum__Alt__DahaAlt=deger     →  "Bolum:Alt:DahaAlt"
#
#  Uygulama açılırken bu dosyayı ortam değişkenlerine yükler; anahtarları
#  eşleyen ekstra bir kod YOKTUR, .NET'in `AddEnvironmentVariables()`
#  sağlayıcısı `__` işaretini `:` yapıp kendisi bulur. Bunun iki sonucu var:
#
#    • Aynı ayar `.env` ile de, IIS/Docker/systemd ortam değişkeniyle de
#      verilebilir — okuma yolu tek.
#    • GERÇEK ortam değişkeni HER ZAMAN kazanır; `.env` onu ezmez. Yayın
#      makinesinde "dosyada ne yazıyorsa o çalışır" sürprizi olmaz.
#
#  Anahtarlar büyük/küçük harf duyarsızdır (`JWT__SECRET` = `Jwt__Secret`).
#
#  ── BU DOSYADA NE VAR, NE YOK ────────────────────────────────────────────
#  VAR : altyapı ve sırlar — veritabanı, imza anahtarı, SMS hesabı, nesne
#        deposu anahtarları, Firebase kimliği. Bunlar veritabanında
#        tutulamaz (veritabanına bağlanmak için zaten gerekiyorlar) ve
#        yedeklere düşmemeleri tercih edilir.
#
#  YOK : kurum adı, amblem, kurumsal renkler. Onlar VERİTABANINDA
#        (`kurum_bilgileri` tablosu, tek satır) ve arayüzden düzenlenir:
#        Sistem → Kurum Bilgileri. `sistem.kurum` izni gerekir.
#
#        Aşağıdaki INSTITUTION__* / BRAND__* satırları yalnızca TOHUMDUR:
#        tablo boşken ilk satır bu değerlerden açılır. Sonrasında dosyayı
#        değiştirmek hiçbir şeyi değiştirmez — arayüzü kullanın.
#        Yani sıfırdan kurulum hâlâ "sadece .env doldur, çalıştır".
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────── VERİTABANI ──────
# PostgreSQL bağlantısı. Havuz sınırı BİLİNÇLİ: PostgreSQL örneği başka
# uygulamalarla paylaşılıyor olabilir ve Npgsql'in varsayılanı (100) sunucunun
# bütün yuvalarını tek başına kaplayabiliyor (SQLSTATE 53300). Yazılmazsa kod
# 25/1/60 varsayılanlarını uygular — bkz. Data/BaglantiAyari.cs.
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=5432;Database=workcollab;Username=workcollab;Password=DEGISTIR;Maximum Pool Size=25"

# Açılışta bekleyen migration'lar otomatik uygulansın mı?
# Tek sunuculu kurulumlarda true bırakın. BİRDEN ÇOK uygulama sunucusu aynı
# veritabanına bağlanıyorsa false yapın ve migration'ı yayın hattında tek
# seferde çalıştırın; aksi hâlde iki örnek aynı anda şema değiştirmeye kalkar.
Database__AutoMigrate=true


# ──────────────────────────────────────────────────── KİMLİK DOĞRULAMA ──────
# JWT imza anahtarı. EN AZ 32 KARAKTER (HMAC-SHA256).
#
# ⚠ DEĞİŞTİRİLİRSE SAHADAKİ BÜTÜN OTURUMLAR DÜŞER — mobil uygulama dahil
#   herkes yeniden giriş yapmak zorunda kalır. Kurulumdan sonra dokunmayın.
#
# Rastgele üretmek için:  openssl rand -base64 48
Jwt__Secret="DEGISTIR-en-az-32-karakter-rastgele-dizi"

# Jetonu üreten ve tüketen taraf. Uygulamanın genel adresiyle aynı olmalı.
Jwt__ValidIssuer="https://ornek.kurum.gov.tr"
Jwt__ValidAudience="https://ornek.kurum.gov.tr"

# Jeton ömrü — DAKİKA. Yayındaki değer 900 (15 saat); mobil uygulamanın oturum
# davranışı buna göre ayarlı, düşürmek kullanıcıları gün içinde tekrar giriş
# yapmaya zorlar.
Jwt__TokenExpiration=900


# ──────────────────────────────────────────────────────────── UYGULAMA ──────
# Uygulamanın DIŞARIDAN görünen adresi. Bildirim yönlendirmelerinde, SMS
# içindeki bağlantılarda ve ProblemDetails "type" bağlantılarında kullanılır.
# Sonunda eğik çizgi OLMAMALI.
App__BaseUrl="https://ornek.kurum.gov.tr"

# Uygulama adı — API künyesinde ve (kurum kaydı boşsa) arayüzde görünür.
# NOT: Arayüzdeki asıl kaynak veritabanıdır; buradaki değer yalnızca tohum.
App__Name="Randevu Takip Sistemi"
App__ShortName="Randevu Takip"
App__Description="Başkanlık makamı ajanda, talep ve iş takip sistemi."

# API künyesinde görünen destek bilgisi (isteğe bağlı).
App__SupportUrl=""
App__SupportEmail=""


# ────────────────────────────────────────────────── DOSYA DEPOLAMA ──────────
# İki seçenek var:
#
#   Local  (VARSAYILAN) — dosyalar sunucunun diskinde, `wwwroot/uploads`
#          altında. İki yıldır yayında olan davranış budur. Tek sunuculu
#          kurulumlarda en basit ve en hızlı seçenek.
#
#   S3     — S3 uyumlu nesne deposu (MinIO, AWS S3, Ceph, Wasabi…). Şu iki
#          durumda GEREKLİ: (1) uygulama birden çok sunucuda çalışıyor — bir
#          sunucuya yüklenen dosyayı diğeri göremez; (2) kapsayıcıyla
#          dağıtılıyor ve yayın klasörü kalıcı değil.
#
# Ayarlar eksikken S3 seçilirse uygulama AÇILMAZ. Sessizce yerele düşmek çok
# daha kötü olurdu: yükleme çalışmaya devam eder, dosyalar beklenen yere
# gitmez ve kimse fark etmez.
Storage__Provider=Local

# ── Yerel depolama ──
# `wwwroot` altındaki yükleme klasörü. VAR OLAN BİR KURULUMDA DEĞİŞTİRMEYİN:
# veritabanındaki mevcut `/uploads/...` yollarını geçersiz kılar.
Storage__UploadPath=uploads

# Kullanıcıdan kullanıcıya gönderilen belgelerin klasörü.
# Boş bırakılabilir → `wwwroot/uploads/gonderim` kullanılır ve orası zaten
# yazılabilir durumdadır (yayında ek izin ayarı gerekmez).
# Belgelerin sürümden sürüme taşınmasını istemiyorsanız yayın klasörünün
# DIŞINDA bir yol verin, örn: D:\workcollab-veri\gonderim
Storage__SendDirectory=""

# ── Nesne deposu (yalnızca Storage__Provider=S3 iken okunur) ──
# Uç nokta ŞEMASIZ yazılır: "127.0.0.1:9000" ya da
# "s3.eu-central-1.amazonaws.com". Başına https:// yazılırsa temizlenir.
Storage__S3__Endpoint="127.0.0.1:9000"
Storage__S3__AccessKey="DEGISTIR"
Storage__S3__SecretKey="DEGISTIR"
Storage__S3__Bucket="workcollab"
# AWS bölgesi. MinIO'da boş bırakılabilir.
Storage__S3__Region=""
# Yerel MinIO kurulumlarında genelde false, AWS'de true.
Storage__S3__UseSsl=false
# Aynı kovayı birden çok kurum paylaşacaksa ayırıcı önek, örn. "kurum-a/".
Storage__S3__Prefix=""
# Kova yoksa açılışta oluşturulsun mu? Kovayı yönetici elle açıp politika
# verdiyse false yapın.
Storage__S3__CreateBucketIfMissing=true
#
# ⚠ S3'e GEÇERKEN: var olan `wwwroot/uploads` içeriğini kovaya AYNI yolla
#   kopyalayın (`uploads/ajanda/...` nesne adı olarak). Veritabanında hiçbir
#   kayıt değişmez; eski `/uploads/...` adresleri de çalışmaya devam eder
#   (Middleware/UzakDepoKopruSu.cs) — yayındaki mobil uygulama o adresleri
#   kullandığı için bu şart.
#     mc mirror ./wwwroot/uploads  yerel/workcollab/uploads
#     mc mirror ./wwwroot/uploads/gonderim  yerel/workcollab/gonderim


# ───────────────────────────────────────────────────────────────── SMS ──────
# Sağlayıcının gönderim uç noktası ve hesabı.
Sms__Url="https://panel.ornek.com.tr:9588/sms/create"
Sms__Username="DEGISTIR"
Sms__Password="DEGISTIR"
# Mesajın başında görünen gönderici adı. Sağlayıcıda KAYITLI olmayan bir
# başlıkla gönderim reddedilir.
Sms__Sender="ORNEK BLD"


# ──────────────────────────────────────────────── BİLDİRİM (Firebase) ──────
# Sunucu tarafı: yönetici SDK'sı için hizmet hesabı JSON dosyasının yolu.
# Göreli yol uygulama köküne göre çözülür. Boş bırakılırsa bildirim gönderimi
# devre dışı kalır ve UYGULAMA YİNE AÇILIR — dosyanın yokluğu bir kurulumu
# tamamen durdurmamalı.
Firebase__CredentialsPath="firebase-service-account.json"

# İstemci tarafı: SPA ve mobil bu değerleri GET /api/v2/institution ile
# ÇALIŞMA ANINDA alır. Gizli değiller (tarayıcıya nasılsa iniyorlar) ama
# kuruma özeller — ön yüz derlemesine gömülselerdi her kurum için ayrı bir
# SPA derlemesi gerekirdi.
Firebase__ProjectId="DEGISTIR"
Firebase__ApiKey="DEGISTIR"
Firebase__AuthDomain="DEGISTIR.firebaseapp.com"
Firebase__StorageBucket="DEGISTIR.firebasestorage.app"
Firebase__MessagingSenderId="DEGISTIR"
Firebase__AppId="DEGISTIR"
# Web push için VAPID ORTAK anahtarı (Firebase konsolu → Cloud Messaging →
# Web Push certificates). Özel anahtar DEĞİL.
Firebase__VapidPublicKey="DEGISTIR"


# ─────────────────────────────────────────────────────────── MODÜLLER ──────
# "Halk günü" talep tipinin veritabanı kimliği. Tohum verisinden gelir ve
# kuruma göre değişebilir.
# BOŞ/0 bırakın: o zaman sistem tipi ADINA göre arar ("halk gün..."), bulamazsa
# 1'e düşer. Buraya değer yazmak o zinciri kısa devre yapar.
Requests__PublicDayTypeId=0


# ═══════════════════════════════════════════════════════════════════════════
#  KURUM KİMLİĞİ — YALNIZCA İLK KURULUM TOHUMU
#
#  Aşağıdaki değerler SADECE `kurum_bilgileri` tablosu boşken kullanılır.
#  Tablo doldurulduktan sonra bu satırları değiştirmek HİÇBİR ŞEYİ
#  DEĞİŞTİRMEZ — arayüzden düzenleyin: Sistem → Kurum Bilgileri.
#
#  Neden veritabanında? Kurum adını ya da amblemi değiştirmek için sunucuya
#  girip uygulamayı yeniden başlatmak gerekmesin diye. Yetkili kullanıcı
#  arayüzden düzenler, değişiklik anında yayılır.
# ═══════════════════════════════════════════════════════════════════════════

# ── Kimlik ──
Institution__Name="Örnek Belediyesi"
Institution__ShortName="Örnek Bld."
# Çıktıların (PDF/Excel) tepesinde basılan ad. Boşsa Name kullanılır.
Institution__DisplayName="Örnek Belediyesi"
# Uygulamayı işleten birim.
Institution__Department="Başkanlık Makamı"
# Künye/alt bilgi satırı — çıktıların ve giriş ekranının dibinde.
Institution__FooterNote="Bilgi İşlem Müdürlüğü"

# ── İletişim ──
Institution__Website="https://www.ornek.bel.tr"
Institution__Address="Örnek Mah. Cumhuriyet Cad. No:1, Örnek"
Institution__Phone="0000 000 00 00"
Institution__Email="bilgi@ornek.bel.tr"

# ── Kurumsal kimlik (tema çekirdeği) ──
# SPA bu üç renkten geri kalan bütün tonları türetir.
Brand__Primary="#002E6D"
Brand__Accent="#A78952"
Brand__Neutral="#4D4D4F"
# Koyu temada birincil renk okunmuyorsa açılmış karşılığı. Boşsa SPA kendisi
# açar.
Brand__PrimaryDark="#1E5FBF"

# ── Görseller ──
# `wwwroot` köküne göre yol. Kurum değişince yalnızca dosyalar değiştirilir.
Brand__Logo="/amblem.png"
Brand__Favicon="/ikon/favicon-32.png"
Brand__AppIcon="/ikon/ikon-512.png"
# Çıktılarda (PDF başlığı, isim kartı) kullanılan amblem. Boşsa Logo kullanılır.
Brand__PrintLogo=""
